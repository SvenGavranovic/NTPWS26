# Kopirati u .env i upisati stvarne vrijednosti. .env se NE commita.

APP_ENV=development
# true samo pri razvoju (detalji pogrešaka na stranici); korisnici uvijek trebaju false
APP_DEBUG=false
APP_URL=http://localhost/zagreb-prijave
APP_TIMEZONE=Europe/Zagreb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zagreb_prijave
DB_USER=root
DB_PASS=

# TomTom Traffic API (faza 8)
TOMTOM_API_KEY=upisati_vlastiti_kljuc
TOMTOM_TIMEOUT=5
TOMTOM_CACHE_TTL=90
