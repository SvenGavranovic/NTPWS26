{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vijest-nova",
  "title": "Nova vijest (POST /api/v1/vijesti)",
  "type": "object",
  "required": ["naslov", "sazetak", "sadrzaj", "kategorija_id"],
  "additionalProperties": false,
  "properties": {
    "naslov": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "Naslov vijesti"
    },
    "sazetak": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Kratki opis za popis vijesti (običan tekst)"
    },
    "sadrzaj": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "HTML sadržaj; poslužitelj ga čisti HTMLPurifierom"
    },
    "kategorija_id": {
      "type": "integer",
      "minimum": 1,
      "description": "ID postojeće kategorije (GET /api/v1/kategorije)"
    },
    "status": {
      "type": "string",
      "enum": ["nacrt", "objavljeno"],
      "default": "nacrt"
    }
  },
  "examples": [
    {
      "naslov": "Zatvaranje Savske ceste",
      "sazetak": "Savska cesta bit će zatvorena u subotu zbog radova.",
      "sadrzaj": "<p>Obilazak je preko Vukovarske ulice.</p>",
      "kategorija_id": 2,
      "status": "objavljeno"
    }
  ]
}
